---
const { entry } = Astro.locals.starlightRoute;
const pageAlias = entry.id.split("/").at(-1);
---

{pageAlias && pageAlias !== "_top" && <span id={pageAlias} class="page-title-alias"></span>}
<h1 id="_top">{entry.data.title}</h1>

<style>
  @layer starlight.core {
    .page-title-alias {
      position: relative;
      top: calc(-1 * var(--sl-nav-height));
      visibility: hidden;
    }

    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>

