---
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}`;
const withBase = (path) => `${base}${path.replace(/^\/+/, "")}`;

const sections = [
  ["Getting Started", "getting-started/"],
  ["Glossary", "glossary/"],
  ["Data", "data/"],
  ["Data Model", "data-model/"],
  ["Market Data API", "market-data-api/"],
  ["Data Services", "data-services/"],
  ["Market Search", "market-search/"],
  ["Visualization", "visualization/"],
  ["dxFeed Retail Products", "dxfeed-retail-products/"],
  ["Support", "support/"],
  ["FAQ", "faq/"],
];
---

<div class="dx-home">
  <section
    class="dx-home-hero"
    style={`--dx-hero-image: url("${withBase("brand/dxfeed-hero.svg")}")`}
  >
    <div class="dx-home-hero__inner">
      <img
        class="dx-home-hero__logo"
        src={withBase("brand/dxfeed-kb-logo-hero.svg")}
        alt="dxFeed Knowledge Base"
        width="595"
        height="56"
      />
      <p>
        Our self-service dxFeed knowledge base is designed to provide information
        on our products and services and to help you find solutions efficiently.
      </p>
      <button
        type="button"
        class="dx-home-search"
        data-home-search
        aria-label="Search the dxFeed Knowledge Base"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32">
          <path
            d="m21 21-4.35-4.35m2.35-5.4A7.75 7.75 0 1 1 3.5 11.25a7.75 7.75 0 0 1 15.5 0Z"
          ></path>
        </svg>
        <span>Search</span>
        <kbd>/</kbd>
      </button>
    </div>
  </section>

  <nav class="dx-home-main" aria-label="Knowledge Base sections">
    <div class="dx-home-grid">
      {
        sections.map(([label, path]) => (
          <a class="dx-home-card" href={withBase(path)}>
            <span>{label}</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20">
              <path d="m7 4 6 6-6 6"></path>
            </svg>
          </a>
        ))
      }
    </div>
  </nav>

  <footer class="dx-home-footer">
    <span>© 2009–2026 Devexperts Inc. Devexperts™, dxFeed™. All rights reserved.</span>
    <a href="https://www.dxfeed.com/">dxfeed.com</a>
  </footer>
</div>

<script>
  const homeSearch = document.querySelector("[data-home-search]");
  const headerSearch = document.querySelector(
    "header.header button[data-open-modal]",
  );

  if (homeSearch instanceof HTMLButtonElement && headerSearch instanceof HTMLButtonElement) {
    homeSearch.addEventListener("click", () => headerSearch.click());
  }
</script>

<style>
  .dx-home {
    min-height: 100vh;
    color: #1a1b1f;
    background: #e5e5e5;
  }

  .dx-home-hero {
    min-height: 363px;
    padding: 64px 32px 48px;
    color: #fff;
    background: #131419 var(--dx-hero-image) center / cover no-repeat;
  }

  .dx-home-hero__inner {
    width: min(1212px, 100%);
    margin: 0 auto;
    text-align: center;
  }

  .dx-home-hero__logo {
    display: block;
    width: min(595px, 80vw);
    height: auto;
    margin: 0 auto 36px;
  }

  .dx-home-hero p {
    max-width: 760px;
    margin: 0 auto 32px;
    color: #fff;
    font-size: 16px;
    line-height: 1.35;
  }

  .dx-home-search {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    width: 100%;
    min-height: 72px;
    padding: 0 24px;
    color: #6f7478;
    font: 400 24px/1 "Roboto", sans-serif;
    text-align: left;
    background: #fff;
    border: 1px solid #e7e7e7;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgb(0 0 0 / 10%);
    cursor: pointer;
  }

  .dx-home-search:hover {
    border-color: #c0c2c8;
    box-shadow: 0 6px 20px rgb(0 0 0 / 14%);
  }

  .dx-home-search:focus-visible {
    outline: 3px solid #f96b2e;
    outline-offset: 3px;
  }

  .dx-home-search svg {
    fill: none;
    stroke: #31383d;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  .dx-home-search kbd {
    padding: 5px 9px;
    color: #6f7478;
    font: 500 14px/1 "Roboto Mono", monospace;
    background: #f4f4f4;
    border: 1px solid #dedede;
    border-radius: 4px;
  }

  .dx-home-main {
    width: min(1212px, calc(100% - 48px));
    margin: 24px auto 48px;
    overflow: hidden;
    background: #fafafa;
    border-radius: 10px;
  }

  .dx-home-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .dx-home-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 174px;
    padding: 32px;
    color: #1a1b1f;
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    border-right: 1px solid #e3e3e3;
    border-bottom: 1px solid #e3e3e3;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .dx-home-card:nth-child(3n) {
    border-right: 0;
  }

  .dx-home-card:hover {
    color: #f96b2e;
    background: #fff;
  }

  .dx-home-card:focus-visible {
    z-index: 1;
    outline: 3px solid #f96b2e;
    outline-offset: -3px;
  }

  .dx-home-card svg {
    flex: none;
    fill: none;
    stroke: #989ca0;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .dx-home-card:hover svg {
    stroke: #f96b2e;
  }

  .dx-home-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    width: min(1212px, calc(100% - 48px));
    margin: 0 auto;
    padding: 0 0 32px;
    color: #6a6f73;
    font-size: 13px;
  }

  .dx-home-footer a {
    color: #3292f3;
    text-decoration: none;
  }

  @media (max-width: 800px) {
    .dx-home-hero {
      min-height: 320px;
      padding: 52px 20px 36px;
    }

    .dx-home-hero__logo {
      margin-bottom: 28px;
    }

    .dx-home-search {
      min-height: 60px;
      font-size: 19px;
    }

    .dx-home-main {
      width: min(100% - 32px, 620px);
    }

    .dx-home-grid {
      grid-template-columns: 1fr;
    }

    .dx-home-card,
    .dx-home-card:nth-child(3n) {
      min-height: 92px;
      border-right: 0;
    }

    .dx-home-footer {
      width: calc(100% - 32px);
    }
  }
</style>
