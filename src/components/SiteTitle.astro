---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}`;
const logoSrc = `${base}brand/dxfeed-kb-logo.svg`;
---

<a href={siteTitleHref} class="dx-site-title">
  <img src={logoSrc} alt={siteTitle} width="132" height="24" />
</a>

<style>
  .dx-site-title {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    text-decoration: none;
  }

  img {
    display: block;
    width: 150px;
    height: auto;
  }
</style>
